# AI Provider (openai or anthropic)
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=resumeness

# Server
PORT=8000

# Auth (Clerk) — used to verify bearer tokens on user-scoped routes.
# Find this at Clerk Dashboard > API Keys > "Frontend API URL" for your instance
# (e.g. https://your-app.clerk.accounts.dev, or your custom domain).
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# Certificates — HMAC signing key for tamper-evident certificate verification.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CERT_SIGNING_SECRET=change_me_to_a_random_secret
