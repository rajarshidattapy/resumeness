# Backend environment configuration
# Copy this file to .env and fill in values

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=glm-4.7:cloud

# Optional: OpenAI API (if using OpenAI instead of Ollama)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Database (optional - defaults to in-memory/localStorage sync)
# DATABASE_URL=postgresql://user:pass@localhost:5432/resumeness
# REDIS_URL=redis://localhost:6379

# LaTeX compilation
LATEX_API_URL=https://latex.ytotech.com/builds/sync

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
